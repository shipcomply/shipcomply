{
  "$schema": "https://shipcomply.dev/schemas/detection-rule.json",
  "version": "1", "id": "dob", "name": "Date of birth collection",
  "jurisdiction": ["DPDP", "GDPR"],
  "compliance_flags": ["DPDP_S4", "GDPR_A5_1_B", "GDPR_A9"],
  "patterns": [
    { "type": "jsx_attribute", "attribute": "name", "value": "dateOfBirth", "element": "input" },
    { "type": "jsx_attribute", "attribute": "name", "value": "dob", "element": "input" },
    { "type": "identifier", "name_pattern": "dateOfBirth|birthDate|dob|birthday" }
  ]
}
