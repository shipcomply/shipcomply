{
  "$schema": "https://shipcomply.dev/schemas/detection-rule.json",
  "version": "1", "id": "name", "name": "Personal name collection",
  "jurisdiction": ["DPDP", "GDPR"],
  "compliance_flags": ["DPDP_S4", "GDPR_A5_1_A"],
  "patterns": [
    { "type": "jsx_attribute", "attribute": "name", "value": "firstName", "element": "input" },
    { "type": "jsx_attribute", "attribute": "name", "value": "lastName", "element": "input" },
    { "type": "identifier", "name_pattern": "firstName|lastName|fullName|userName|displayName" }
  ]
}
