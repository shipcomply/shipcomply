# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── LLM Providers (all free tiers) ─────────────────────────────────────────
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
CEREBRAS_API_KEY=csk-...

# ─── Ollama (local, no key needed) ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ─── GitHub App ──────────────────────────────────────────────────────────────
GITHUB_APP_ID=your-app-id
GITHUB_PRIVATE_KEY_PATH=./apps/github-app/private-key.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# ─── Cloudflare R2 (PDF storage) ─────────────────────────────────────────────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret
R2_BUCKET_NAME=shipcomply-artifacts

# ─── Sentry (optional, free tier) ────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://public@sentry.io/0
SENTRY_DSN=https://ingest@sentry.io/0

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NODE_ENV=development

# ─── Offline mode ────────────────────────────────────────────────────────────
OFFLINE=false
