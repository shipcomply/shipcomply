# ShipComply — Environment Variables Reference
# Copy to .env for local dev. Never commit .env.
# Render/Vercel vars marked with [R] / [V] — set in those dashboards.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ APPS/WEB [V] — Vercel dashboard ═════════════════════════════════════════

# Clerk — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# (set as literals in vercel.json — no dashboard entry needed)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# NEXT_PUBLIC_API_URL=https://shipcomply-api.onrender.com


# ═══ SERVICES/API [R] — Render dashboard ═════════════════════════════════════

# Neon Postgres — https://console.neon.tech → Connection Details
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-2.aws.neon.tech/shipcomply?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/shipcomply?sslmode=require

# Clerk
CLERK_SECRET_KEY=sk_test_
CLERK_JWKS_URL=https://api.clerk.dev/v1/jwks
CLERK_WEBHOOK_SECRET=whsec_

# LLM Providers — minimum viable: GROQ_API_KEY only
# Groq     → https://console.groq.com      free 14,400 req/day
GROQ_API_KEY=gsk_
# Gemini   → https://aistudio.google.com   free 500 req/day
GEMINI_API_KEY=AIza
# Cerebras → https://cloud.cerebras.ai     free tier
CEREBRAS_API_KEY=csk-
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
KIMI_API_KEY=

# Ollama (local fallback — not needed on Render)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Cloudflare R2 — https://dash.cloudflare.com → R2
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_R2_BUCKET=shipcomply-artifacts
CF_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CF_KV_NAMESPACE_ID=
CF_QUEUE_NAME=scan-jobs
CF_BROWSER_RENDERING_URL=

# Stripe — https://dashboard.stripe.com → Developers
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# Observability
SENTRY_DSN=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./apps/github-app/private-key.pem
GITHUB_WEBHOOK_SECRET=

# App
CORS_ORIGINS=["https://shipcomply.dev","http://localhost:3000"]
WEB_URL=https://shipcomply.dev
DEBUG=false
OFFLINE=false
